		cb0[38] = (float4(1.442695, 1.442695, 0, 0) * float4(float4(AtmosUnk170.xxxx).x, float4(AtmosUnk198.xxxx).xyz));
		cb0[39] = (float4(1.442695, 1.442695, 0, 0) * float4(float4(AtmosUnk164.xxxx).x, float4(AtmosUnk194.xxxx).xyz));
