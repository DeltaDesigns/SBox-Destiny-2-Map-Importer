		cb0[40] = (float4(float4(float4(float4(0, 0, 0, 0).x, (float4(1, 0, 0, 0) / (float4(AtmosUnk16C.xxxx) - float4(AtmosUnk168.xxxx))).xyz).xy, float4(FrameTimeOfDay.xxxx).xy).xyz, (-(float4(AtmosUnk168.xxxx) / (float4(AtmosUnk16C.xxxx) - float4(AtmosUnk168.xxxx)))).x));
		cb0[41] = (AtmosUnk180 * (float4(AtmosUnk190.xxxx).xxxx));
		cb0[42] = (float4(1, 0, 0, 0) - float4(AtmosUnk1C0.xxxx));
		cb0[43] = float4((float4(1, 0, 0, 0) / (GlobalChannel41 + float4(0.001, 0.001, 0.001, 0.001))).x, (-(GlobalChannel37 / (GlobalChannel41 + float4(0.001, 0.001, 0.001, 0.001)))).xyz);
		cb0[56] = ((((float4((float4(1, 1, 1, 1).xyzz).xyz, (dot((float4((float4(1, 1, 1, 1).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) * (GlobalChannel140.xxxx));
		cb0[58] = ((((float4((float4(1, 1, 1, 1).xyzz).xyz, (dot((float4((float4(1, 1, 1, 1).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) * (GlobalChannel140.xxxx));
		cb0[69] = ((((float4((float4(1, 1, 1, 1).xyzz).xyz, (dot((float4((float4(1, 1, 1, 1).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) * (GlobalChannel145.xxxx));
		cb0[74] = float4((float4(1, 0, 0, 0) / (max((GlobalChannel30.xxxx), float4(0.01, 0, 0, 0)))).x, (-((GlobalChannel29.xxxx) * (float4(1, 0, 0, 0) / (max((GlobalChannel30.xxxx), float4(0.01, 0, 0, 0)))))).xyz);
		cb0[82] = float4(((float4((GlobalChannel138.xxxx).x, (GlobalChannel139.xxxx).xyz).yyyy) - (float4((GlobalChannel138.xxxx).x, (GlobalChannel139.xxxx).xyz).xxxx)).x, (float4((GlobalChannel138.xxxx).x, (GlobalChannel139.xxxx).xyz).xxxx).xyz);
		cb0[60] = ((((float4(((GlobalChannel31 * (GlobalChannel32.xxxx)).xyzz).xyz, (dot((GlobalChannel31 * (GlobalChannel32.xxxx)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) - ((((float4((float4(1, 1, 1, 1).xyzz).xyz, (dot((float4((float4(1, 1, 1, 1).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) * (GlobalChannel140.xxxx)));
		cb0[61] = ((((float4(((GlobalChannel33 * (GlobalChannel34.xxxx)).xyzz).xyz, (dot((GlobalChannel33 * (GlobalChannel34.xxxx)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) - ((((float4((float4(1, 1, 1, 1).xyzz).xyz, (dot((float4((float4(1, 1, 1, 1).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) * (GlobalChannel140.xxxx)));
		cb0[72] = ((((float4(((GlobalChannel28 * (GlobalChannel27.xxxx)).xyzz).xyz, (dot((float4(((GlobalChannel28 * (GlobalChannel27.xxxx)).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) - ((((float4((float4(1, 1, 1, 1).xyzz).xyz, (dot((float4((float4(1, 1, 1, 1).xyzz).xyz, float4(0, 0, 0, 0).x)), float4(0.3, 0.59, 0.11, 0))).x)) * (float4(ExposureScale.xxxx).xxxx)) * float4(0.25, 0.25, 0.25, 0.25)) * (GlobalChannel145.xxxx)));

